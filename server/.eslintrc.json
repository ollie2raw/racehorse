{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json",
    "ecmaFeatures": {}
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2020": true
  },
  "ignorePatterns": [
    "dist/**",
    "**/*.test.ts"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "no-console": "error"
  },
  "overrides": [
    {
      "files": [
        "scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/dailyFritzVerifier.ts",
        "src/ghost/verifier.ts",
        "src/dailyPuzzleSubmissionValidation.ts",
        "src/puzzleRush/grading.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@racehorse/game-core/bot",
                "message": "Verifiers must not import bot heuristics (GC-4): estimateDrawCostFromPublicInfo is the only non-integer computation in game-core."
              }
            ]
          }
        ]
      }
    }
  ]
}