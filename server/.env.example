SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
ENABLE_QA_TOURNAMENT_SEED=0
QA_TOURNAMENT_USER_ID=
QA_ALLOW_NONLOCAL_STAGING=0
SENTRY_DSN=your_sentry_dsn
# Enable only after all four 2026-08-01 Daily Fritz migrations are applied.
DAILY_FRITZ_TRANSACTIONAL_COMMANDS=false
MULTIPLAYER_TRANSACTIONAL_COMMANDS=false
# Enable only after 2026-08-06_multiplayer_durable_invites.sql is applied.
MULTIPLAYER_DURABLE_INVITES=false
# Cross-instance Socket.io pub/sub + distributed rate limiting. Required in any
# multi-instance deployment (e.g. Vercel Fluid Compute); optional locally.
REDIS_URL=
# Authorizes GET /api/cron/weekly-ranking-maintenance. Vercel auto-sends this as a
# Bearer token when CRON_SECRET is set as a project env var — no extra Vercel config needed.
CRON_SECRET=
