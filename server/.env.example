# Feature-flag manifest & convention: docs/server-feature-flags.md
SUPABASE_URL=your_supabase_url
# Optional: Supabase pooler/pgBouncer REST endpoint (e.g. https://<ref>.pooler.supabase.com).
# When set, supabaseFetch routes all requests here instead of SUPABASE_URL.
SUPABASE_POOLER_URL=
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Comma-separated exact Supabase user IDs in the staged post-game review cohort.
# Rollout follow-up: populate only the existing admin's user ID; leave empty
# until production deployment is ready. Do not commit real user IDs here.
POST_GAME_REVIEW_COHORT_USER_IDS=
SENTRY_DSN=your_sentry_dsn
# Enable only after all four 2026-08-01 Daily Fritz migrations are applied.
DAILY_FRITZ_TRANSACTIONAL_COMMANDS=false
# Scheduled-tournament scheduler tick + no-show reconciler. Default true.
# Processes with it on compete for the orchestrator lease (needs the
# 2026-10-08_tournament_orchestrator_lease.sql migration); only the holder
# orchestrates. Set false on processes that should never orchestrate.
TOURNAMENT_SCHEDULER_ENABLED=true
# Orchestrator lease TTL in ms (default 120000, clamped to 30000..600000).
# TOURNAMENT_ORCHESTRATOR_LEASE_TTL_MS=120000
# New on-demand Fritz Cups (POST /api/tournaments/fritz-cup). Default false.
# Requires the 2026-10-07_tournament_kind_fritz_cup.sql migration. Turning it
# off stops new cups only; existing cups keep running to completion.
FRITZ_CUP_ENABLED=false
