{
  "name": "server",
  "version": "1.0.0",
  "description": "Racehorse Dominoes backend server",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prebuild": "npm run build --workspace=@racehorse/game-core",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run --shard=1/4 && vitest run --shard=2/4 && vitest run --shard=3/4 && vitest run --shard=4/4",
    "test:focused": "vitest run",
    "soak:concurrent-load": "tsx scripts/concurrentLoadSoak.ts",
    "soak:daily-fritz-authority": "tsx scripts/dailyFritzAuthoritySoak.ts",
    "soak:fritz-challenge-authority": "tsx scripts/fritzChallengeAuthoritySoak.ts",
    "soak:daily-puzzle-authority": "tsx scripts/dailyPuzzleAuthoritySoak.ts",
    "backtest:human-move-log": "tsx scripts/backtestHumanMoveLogVerification.ts",
    "check:policy-manifest": "tsx scripts/checkPolicyManifest.ts",
    "check:cascade-delete": "tsx scripts/checkCascadeDeleteCompleteness.ts",
    "chaos:multiplayer-restart": "tsx scripts/multiplayerProcessRestartChaos.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "check:daily-ladder": "node dist/checkDailyPuzzleLadder.js",
    "seed:daily-ladder": "node dist/seedDailyPuzzleLadder.js",
    "gen:puzzles": "bash ../scripts/gen-puzzles.sh",
    "nobrainer:validate": "node -e \"require('ts-node/register/transpile-only'); require('./scripts/validateNoBrainers.ts')\"",
    "nobrainer:generate": "node -e \"require('ts-node/register/transpile-only'); require('./scripts/generateNoBrainers.ts')\"",
    "gen:puzzles:legacy": "tsx src/generatePuzzles.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts --max-warnings 9999"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@racehorse/game-core": "*",
    "@sentry/node": "^10.62.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/node-cron": "^3.0.11",
    "@types/pino": "^7.0.4",
    "prettier": "^3.8.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "^4.0.18"
  }
}
