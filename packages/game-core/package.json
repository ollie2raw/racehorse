{
  "name": "@racehorse/game-core",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./invariants": {
      "types": "./dist/invariants.d.ts",
      "default": "./dist/invariants.js"
    },
    "./open-ends": {
      "types": "./dist/openEndsGeometry.d.ts",
      "default": "./dist/openEndsGeometry.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "default": "./dist/scoring.js"
    },
    "./review": {
      "types": "./dist/reviewContracts.d.ts",
      "default": "./dist/reviewContracts.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./bot": {
      "types": "./dist/botHeuristics.d.ts",
      "default": "./dist/botHeuristics.js"
    },
    "./build-stamp": {
      "types": "./dist/buildStamp.d.ts",
      "default": "./dist/buildStamp.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/write-build-stamp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
