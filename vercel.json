{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://racehorse.onrender.com wss://racehorse.onrender.com https://sentry.io https://*.sentry.io https://o*.ingest.sentry.io; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:file*.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:file*.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:file*.jpeg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:file*.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:file*.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:file*.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:file*.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:file*.woff",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:file*.ttf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/daily-fritz", "destination": "/daily-fritz.html" },
    { "source": "/daily-fritz/leaderboard", "destination": "/daily-fritz-leaderboard.html" },
    { "source": "/daily", "destination": "/daily.html" },
    { "source": "/daily/leaderboard", "destination": "/daily-leaderboard.html" },
    { "source": "/solo", "destination": "/solo.html" },
    { "source": "/solo/fritz", "destination": "/solo-fritz.html" },
    { "source": "/solo/ghost", "destination": "/solo-ghost.html" },
    { "source": "/multiplayer", "destination": "/multiplayer.html" },
    { "source": "/multiplayer/private", "destination": "/multiplayer-private.html" },
    { "source": "/social", "destination": "/social.html" },
    { "source": "/players/:username", "destination": "/players.html" },
    { "source": "/journey", "destination": "/journey.html" },
    { "source": "/learn", "destination": "/learn.html" },
    { "source": "/learn/how-to-play", "destination": "/learn-how-to-play.html" },
    { "source": "/tournament", "destination": "/tournament.html" },
    { "source": "/tournament/:id/result", "destination": "/tournament-result.html" },
    { "source": "/tournament/:id", "destination": "/tournament-detail.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
