# Production configuration for the iOS App Store build (`npm run build:ios`).
#
# Copy to client/.env.ios (gitignored) and fill in the PRODUCTION public values.
# Vite bakes these into the app, so they are visible to anyone who unpacks it:
# only public, client-safe values belong here. NEVER put the Supabase
# service-role key, the admin secret, or any other secret in this file.
#
# The build refuses to run unless every value below is production
# (scripts/iosReleaseGuard.mjs). See docs/ops/ios-release-build.md.

# Game server (REST + Socket.IO). Must be exactly the production origin.
VITE_SERVER_URL=https://racehorse.onrender.com

# Supabase production project: Settings -> API -> Project URL and the "anon"
# public key (NOT service_role).
VITE_SUPABASE_URL=https://<production-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<production anon public key>

# PostHog production project API key (public, phc_...). Host defaults to US cloud.
VITE_POSTHOG_KEY=<phc_...>
VITE_POSTHOG_HOST=

# Sentry client DSN for the production project (public).
VITE_SENTRY_DSN=<https://...@....ingest.us.sentry.io/...>

# Tournament Mode in this native build. Explicit on purpose: turning it on later
# needs a new App Store build. Keep false until the tournament launch gate
# (docs/ops/tournament-launch/README.md) has passed on the web.
VITE_ENABLE_TOURNAMENTS=false
