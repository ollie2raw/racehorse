VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id
VITE_APP_VERSION=0.1.0
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# The Circuit is preserved but hidden from flagship surfaces.
# Dev recovery only: set true in local .env while running `npm run dev`.
# Production never surfaces Circuit even if this is true.
VITE_ENABLE_CIRCUIT_MODE=false
VITE_ENABLE_SPECTATOR_MODE=false
