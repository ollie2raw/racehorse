{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "typecheck": "tsc -b --noEmit",
    "qa:capture-auth": "node scripts/captureAuthenticatedQaFixture.mjs",
    "qa:journey-content": "node scripts/validateJourneyContent.mjs",
    "qa:journey-content:summary": "node scripts/validateJourneyContent.mjs --summary-only",
    "qa:daily-fritz:hand-lifecycle": "node scripts/dailyFritzHandLifecycleQa.mjs",
    "test:bot": "ts-node --esm src/bot/botHeuristics.behaviorTests.ts",
    "test:bot:parity": "ts-node --esm src/bot/engineParity.behaviorTests.ts",
    "test:bot:honesty": "ts-node --esm src/bot/botHonesty.behaviorTests.ts",
    "benchmark:tier": "ts-node --esm src/devtools/benchmark.ts ladder 200",
    "test:bot:tier": "ts-node --esm src/bot/tierDifficulty.behaviorTests.ts",
    "test:hand-lifecycle": "ts-node --esm src/bot/handLifecycle.behaviorTests.ts",
    "test:pre-game-draw": "ts-node --esm src/match/preGameDraw/preGameDrawLogic.behaviorTests.ts && ts-node --esm src/match/preGameDraw/usePreGameDraw.behaviorTests.ts && ts-node --esm src/match/preGameDraw/preGameDrawEligibility.behaviorTests.ts && ts-node --esm src/match/preGameDraw/preGameDrawScatter.behaviorTests.ts",
    "test:open-ends": "ts-node --esm src/game/openEndsGeometry.behaviorTests.ts",
    "test:bot-hooks": "npx tsx src/bot/useMatchUiChrome.behaviorTests.ts && npx tsx src/bot/useAuthoringCapture.behaviorTests.ts && npx tsx src/bot/usePostGamePivotalReview.behaviorTests.ts",
    "test:analyzer": "npx tsx src/analyzer/analyzer.behaviorTests.ts",
    "test:recovery-machine": "ts-node --esm src/multiplayer/recoveryMachine.behaviorTests.ts",
    "debug:learn": "ts-node --esm src/devtools/debugHarness.ts",
    "test:smoke:sockets": "node scripts/socketSmoke.mjs",
    "test:smoke:sockets:stress": "SMOKE_REPEAT=10 node scripts/socketSmoke.mjs",
    "ci:bot": "npm run test:bot && npm run build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx --max-warnings 600",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:deps": "depcruise src --config .dependency-cruiser.json --output-type text",
    "check:multiplayer-arch": "depcruise src/multiplayer --config .dependency-cruiser.multiplayer-arch.json --output-type err",
    "check:multiplayer-cycles": "depcruise src/multiplayer --config .dependency-cruiser.multiplayer-cycles.json --output-type err",
    "check:socket-registry": "npx tsx scripts/validateSocketEventRegistry.ts",
    "check:architecture": "npx tsx scripts/checkArchitectureInvariants.ts",
    "check:bot-match-lazy": "node scripts/checkBotMatchLazyBoundaries.mjs --dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run && node run-behavior-tests.mjs",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "size-check": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@racehorse/game-core": "*",
    "@racehorse/match-protocol": "*",
    "@sentry/react": "^10.59.0",
    "@supabase/supabase-js": "^2.97.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "seedrandom": "^3.0.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
