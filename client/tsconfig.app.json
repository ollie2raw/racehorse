{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@racehorse/game-core": ["../packages/game-core/src/index.ts"],
      "@racehorse/game-core/bot": ["../packages/game-core/src/botHeuristics.ts"],
      "@racehorse/game-core/*": ["../packages/game-core/src/*"],
      "@racehorse/match-protocol": ["../packages/match-protocol/src/index.ts"],
      "@racehorse/match-protocol/*": ["../packages/match-protocol/src/*"]
    }
  },
  "include": ["src", "../packages/match-protocol/src"],
  "exclude": ["src/devtools", "**/*.behaviorTests.ts"]
}
